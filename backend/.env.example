# Copia este archivo a backend/.env y llena los valores. Nunca subas el .env.

# PostgreSQL (docker compose usa las mismas variables para crear la base)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 127.0.0.1:5433 si el backend corre fuera de Docker; docker compose lo cambia a db:5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# disable en local; require en un servidor real
POSTGRES_SSL=disable

# JWT
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Cookie del refresh token en la app web. Si la app y la API están en dominios distintos: none
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# Tutor con IA
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Orígenes permitidos para la app web, en JSON: ["http://localhost:8081"]
CORS_ORIGINS=["http://localhost:8081"]

# Gamificación (docs/diseno/exp-y-racha.md)
XP_PER_EXERCISE_FIRST_TRY=10
XP_PER_EXERCISE_RETRY=5
XP_PERFECT_LESSON_BONUS=5
