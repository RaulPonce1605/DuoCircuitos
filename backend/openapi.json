{
  "components": {
    "schemas": {
      "AuthRead": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserRead"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "refresh_token",
          "user"
        ],
        "title": "AuthRead",
        "type": "object"
      },
      "CheckRequest": {
        "properties": {
          "answer": {
            "discriminator": {
              "mapping": {
                "fill_pattern": "#/components/schemas/FillPatternAnswer",
                "multiple_choice": "#/components/schemas/MultipleChoiceAnswer",
                "numeric": "#/components/schemas/NumericAnswer"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/MultipleChoiceAnswer"
              },
              {
                "$ref": "#/components/schemas/FillPatternAnswer"
              },
              {
                "$ref": "#/components/schemas/NumericAnswer"
              }
            ],
            "title": "Answer"
          }
        },
        "required": [
          "answer"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "CheckResultRead": {
        "properties": {
          "attempt_completed": {
            "title": "Attempt Completed",
            "type": "boolean"
          },
          "correct": {
            "title": "Correct",
            "type": "boolean"
          },
          "correct_answer": {
            "title": "Correct Answer",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "next_exercise": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExerciseInstanceRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "$ref": "#/components/schemas/LessonProgressRead"
          }
        },
        "required": [
          "correct",
          "correct_answer",
          "explanation",
          "progress",
          "next_exercise",
          "attempt_completed"
        ],
        "title": "CheckResultRead",
        "type": "object"
      },
      "ErrorRead": {
        "description": "Error con un código estable que la app traduce (`errors.<code>`).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "ErrorRead",
        "type": "object"
      },
      "ExerciseInstanceRead": {
        "properties": {
          "exercise": {
            "discriminator": {
              "mapping": {
                "fill_pattern": "#/components/schemas/FillPatternPublic",
                "multiple_choice": "#/components/schemas/MultipleChoicePublic",
                "numeric": "#/components/schemas/NumericPublic"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/MultipleChoicePublic"
              },
              {
                "$ref": "#/components/schemas/FillPatternPublic"
              },
              {
                "$ref": "#/components/schemas/NumericPublic"
              }
            ],
            "title": "Exercise"
          },
          "instance_id": {
            "format": "uuid",
            "title": "Instance Id",
            "type": "string"
          }
        },
        "required": [
          "instance_id",
          "exercise"
        ],
        "title": "ExerciseInstanceRead",
        "type": "object"
      },
      "FillPatternAnswer": {
        "properties": {
          "text": {
            "maxLength": 200,
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "fill_pattern",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "FillPatternAnswer",
        "type": "object"
      },
      "FillPatternPublic": {
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "type": {
            "const": "fill_pattern",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "prompt"
        ],
        "title": "FillPatternPublic",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "LessonAttemptRead": {
        "properties": {
          "attempt_id": {
            "format": "uuid",
            "title": "Attempt Id",
            "type": "string"
          },
          "current_exercise": {
            "$ref": "#/components/schemas/ExerciseInstanceRead"
          },
          "lesson": {
            "$ref": "#/components/schemas/LessonRefRead"
          },
          "progress": {
            "$ref": "#/components/schemas/LessonProgressRead"
          }
        },
        "required": [
          "attempt_id",
          "lesson",
          "progress",
          "current_exercise"
        ],
        "title": "LessonAttemptRead",
        "type": "object"
      },
      "LessonAttemptSummaryRead": {
        "properties": {
          "accuracy": {
            "title": "Accuracy",
            "type": "integer"
          },
          "attempt_id": {
            "format": "uuid",
            "title": "Attempt Id",
            "type": "string"
          },
          "concepts": {
            "items": {
              "type": "string"
            },
            "title": "Concepts",
            "type": "array"
          },
          "exercise_count": {
            "title": "Exercise Count",
            "type": "integer"
          },
          "first_try_correct": {
            "title": "First Try Correct",
            "type": "integer"
          },
          "lesson": {
            "$ref": "#/components/schemas/LessonRefRead"
          },
          "streak": {
            "title": "Streak",
            "type": "integer"
          },
          "streak_extended": {
            "title": "Streak Extended",
            "type": "boolean"
          },
          "xp_awarded": {
            "title": "Xp Awarded",
            "type": "integer"
          }
        },
        "required": [
          "attempt_id",
          "lesson",
          "exercise_count",
          "first_try_correct",
          "accuracy",
          "xp_awarded",
          "concepts",
          "streak",
          "streak_extended"
        ],
        "title": "LessonAttemptSummaryRead",
        "type": "object"
      },
      "LessonProgressRead": {
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "completed",
          "total"
        ],
        "title": "LessonProgressRead",
        "type": "object"
      },
      "LessonRefRead": {
        "properties": {
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title"
        ],
        "title": "LessonRefRead",
        "type": "object"
      },
      "LessonSummaryRead": {
        "properties": {
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title"
        ],
        "title": "LessonSummaryRead",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "session_mode": {
            "default": "body",
            "enum": [
              "body",
              "cookie"
            ],
            "title": "Session Mode",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "title": "LogoutRequest",
        "type": "object"
      },
      "MultipleChoiceAnswer": {
        "properties": {
          "option": {
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Option",
            "type": "integer"
          },
          "type": {
            "const": "multiple_choice",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "option"
        ],
        "title": "MultipleChoiceAnswer",
        "type": "object"
      },
      "MultipleChoicePublic": {
        "properties": {
          "options": {
            "items": {
              "type": "string"
            },
            "title": "Options",
            "type": "array"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "type": {
            "const": "multiple_choice",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "prompt",
          "options"
        ],
        "title": "MultipleChoicePublic",
        "type": "object"
      },
      "NodeRead": {
        "properties": {
          "is_current": {
            "title": "Is Current",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "lesson": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LessonSummaryRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "locked",
              "available",
              "completed"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "enum": [
              "lesson",
              "review",
              "chest",
              "assessment"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "key",
          "type",
          "status",
          "is_current",
          "lesson"
        ],
        "title": "NodeRead",
        "type": "object"
      },
      "NumericAnswer": {
        "properties": {
          "type": {
            "const": "numeric",
            "title": "Type",
            "type": "string"
          },
          "unit": {
            "default": "",
            "maxLength": 10,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "maxLength": 40,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "title": "NumericAnswer",
        "type": "object"
      },
      "NumericPublic": {
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "type": {
            "const": "numeric",
            "title": "Type",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "type",
          "prompt",
          "unit"
        ],
        "title": "NumericPublic",
        "type": "object"
      },
      "PathRead": {
        "properties": {
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageRead"
            },
            "title": "Stages",
            "type": "array"
          }
        },
        "required": [
          "stages"
        ],
        "title": "PathRead",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "En modo cookie se omite `refresh_token`: el backend lo lee de la cookie.",
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "session_mode": {
            "default": "body",
            "enum": [
              "body",
              "cookie"
            ],
            "title": "Session Mode",
            "type": "string"
          }
        },
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "display_name": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "session_mode": {
            "default": "body",
            "enum": [
              "body",
              "cookie"
            ],
            "title": "Session Mode",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SectionRead": {
        "properties": {
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "units": {
            "items": {
              "$ref": "#/components/schemas/UnitRead"
            },
            "title": "Units",
            "type": "array"
          }
        },
        "required": [
          "slug",
          "title",
          "units"
        ],
        "title": "SectionRead",
        "type": "object"
      },
      "StageRead": {
        "properties": {
          "sections": {
            "items": {
              "$ref": "#/components/schemas/SectionRead"
            },
            "title": "Sections",
            "type": "array"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "sections"
        ],
        "title": "StageRead",
        "type": "object"
      },
      "StatusRead": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusRead",
        "type": "object"
      },
      "UnitRead": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/NodeRead"
            },
            "title": "Nodes",
            "type": "array"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "nodes"
        ],
        "title": "UnitRead",
        "type": "object"
      },
      "UserRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "streak_current": {
            "title": "Streak Current",
            "type": "integer"
          },
          "streak_longest": {
            "title": "Streak Longest",
            "type": "integer"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "xp_total": {
            "title": "Xp Total",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "timezone",
          "xp_total",
          "streak_current",
          "streak_longest",
          "created_at"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "ValidationErrorRead": {
        "description": "422. `validation_error`: el cuerpo o los parámetros no pasan la validación (trae\n`detail`). Otros códigos (`invalid_answer`) son errores de dominio sin `detail`.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "code"
        ],
        "title": "ValidationErrorRead",
        "type": "object"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Circuitos API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "loginUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            },
            "description": "invalid_credentials"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorRead"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorRead"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            },
            "description": "invalid_token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorRead"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "registerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            },
            "description": "email_taken"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorRead"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/exercise-instances/{instance_id}/check": {
      "post": {
        "operationId": "checkExercise",
        "parameters": [
          {
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Instance Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResultRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            },
            "description": "invalid_token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            },
            "description": "not_found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
