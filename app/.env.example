# Copia este archivo a app/.env. Expo solo expone a la app las variables EXPO_PUBLIC_*.
# Nunca pongas secretos aquí: todo lo EXPO_PUBLIC_ termina dentro de la app.

# URL del backend. En el celular con Expo Go usa la IP de tu computadora (http://192.168.x.x:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000
